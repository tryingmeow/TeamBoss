FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AUTO_TEAM_DATA_DIR=/app/data

WORKDIR /app

RUN groupadd --system auto-team \
    && useradd --system --gid auto-team --home-dir /app auto-team \
    && mkdir -p /app/data \
    && chmod 700 /app/data \
    && chown -R auto-team:auto-team /app

COPY backend/requirements.txt ./requirements.txt
RUN pip install --requirement requirements.txt

COPY --chown=auto-team:auto-team backend/app ./app
COPY --chown=auto-team:auto-team scripts ./scripts

USER auto-team

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
